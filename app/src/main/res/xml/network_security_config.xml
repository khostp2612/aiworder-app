<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许明文流量用于模型下载（Compatible with HarmonyOS） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
